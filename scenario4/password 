<!DOCTYPE html>
<html>
<head>
    <title>Password Strength Meter</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            display: flex;
            justify-content: center;
            padding: 40px 15px;
        }

        .container {
            background: white;
            padding: 25px;
            width: 400px;
            border-radius: 10px;
            box-shadow: 0 0 10px #aaa;
        }

        h2 {
            text-align: center;
            color: #333;
        }

        input[type="password"],
        input[type="text"] {
            width: 95%;
            padding: 10px;
            margin: 10px 0;
            border: 1px solid #777;
            border-radius: 5px;
        }

        .bar {
            width: 100%;
            height: 10px;
            background: #ddd;
            border-radius: 10px;
            margin: 10px 0;
            overflow: hidden;
        }

        #strengthBar {
            width: 0%;
            height: 100%;
            background: transparent;
            transition: 0.3s;
        }

        .rules {
            text-align: left;
            line-height: 2;
            margin-top: 15px;
        }

        .valid {
            color: green;
        }

        .invalid {
            color: #888;
        }

        #strengthText {
            font-weight: bold;
        }
    </style>
</head>

<body>

<div class="container">

    <h2>Password Strength</h2>

    <input
        type="password"
        id="password"
        placeholder="Enter password"
        oninput="checkPassword()"
    >

    <br>

    <label>
        <input
            type="checkbox"
            id="showPassword"
            onchange="togglePassword()"
        >
        Show password
    </label>

    <div class="bar">
        <div id="strengthBar"></div>
    </div>

    <p id="strengthText"></p>

    <div class="rules">
        <p id="rule1">✗ At least 8 characters</p>
        <p id="rule2">✗ One uppercase letter</p>
        <p id="rule3">✗ One lowercase letter</p>
        <p id="rule4">✗ One number</p>
        <p id="rule5">✗ One special symbol</p>
    </div>

</div>

<script>

    function checkPassword() {

        let password =
            document.getElementById("password").value;

        // Five password validation rules
        let rules = [
            password.length >= 8,
            /[A-Z]/.test(password),
            /[a-z]/.test(password),
            /[0-9]/.test(password),
            /[^A-Za-z0-9]/.test(password)
        ];

        let count = 0;

        // Update rule checklist
        rules.forEach((valid, index) => {

            let element =
                document.getElementById("rule" + (index + 1));

            if (valid) {
                element.innerHTML =
                    "✓ " + element.innerHTML.substring(2);

                element.className = "valid";
                count++;
            }
            else {
                element.innerHTML =
                    "✗ " + element.innerHTML.substring(2);

                element.className = "invalid";
            }
        });

        // Update strength bar
        let bar = document.getElementById("strengthBar");
        let text = document.getElementById("strengthText");

        let percentage = (count / 5) * 100;

        bar.style.width = percentage + "%";

        if (password === "") {
            text.innerHTML = "";
            bar.style.background = "transparent";
        }

        else if (count <= 2) {
            text.innerHTML = "Weak";
            bar.style.background = "red";
        }

        else if (count <= 4) {
            text.innerHTML = "Medium";
            bar.style.background = "orange";
        }

        else {
            text.innerHTML = "Strong";
            bar.style.background = "green";
        }
    }

    // Show or hide password
    function togglePassword() {

        let password =
            document.getElementById("password");

        let checkbox =
            document.getElementById("showPassword");

        if (checkbox.checked) {
            password.type = "text";
        }
        else {
            password.type = "password";
        }
    }

</script>

</body>
</html>