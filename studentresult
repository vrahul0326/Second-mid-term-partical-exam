<!DOCTYPE html>
<html>
<head>
    <title>Student Result Card</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f2f2;
            text-align: center;
            padding: 20px;
        }

        .container {
            background: white;
            max-width: 850px;
            margin: auto;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 0 10px #aaa;
        }

        h2 {
            color: #333;
        }

        button {
            background: #444;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
            border-radius: 5px;
        }

        table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #ccc;
            padding: 10px;
        }

        th {
            background: #444;
            color: white;
        }

        .fail {
            background: #ffcccc;
            color: red;
        }

        .summary {
            margin-top: 20px;
            font-weight: bold;
            line-height: 1.8;
        }
    </style>
</head>

<body>

<div class="container">
    <h2>Class Result Sheet</h2>

    <button onclick="generateResults()">
        Generate Results
    </button>

    <div id="output"></div>
</div>

<script>
    // Array of student objects
    const students = [
        {name: "Anita", maths: 90, science: 85, english: 80},
        {name: "Rahul", maths: 65, science: 60, english: 62},
        {name: "Meena", maths: 95, science: 93, english: 94},
        {name: "Karthik", maths: 75, science: 32, english: 70},
        {name: "Divya", maths: 80, science: 75, english: 85}
    ];

    // Function to calculate grade
    function getGrade(percent) {
        if (percent >= 90) return "A+";
        else if (percent >= 75) return "A";
        else if (percent >= 60) return "B";
        else if (percent >= 50) return "C";
        else return "D";
    }

    // Generate result function
    function generateResults() {

        let output = `
        <table>
        <tr>
            <th>Name</th>
            <th>Total (300)</th>
            <th>Percentage</th>
            <th>Grade</th>
            <th>Result</th>
        </tr>`;

        let totalPercentage = 0;
        let passed = 0;
        let topper = "";
        let highest = -1;

        students.forEach(student => {

            let total = student.maths +
                        student.science +
                        student.english;

            let percentage = (total / 300) * 100;

            let grade = getGrade(percentage);

            let result =
                student.maths >= 35 &&
                student.science >= 35 &&
                student.english >= 35
                ? "Pass" : "Fail";

            if (result === "Pass") {
                passed++;
            }

            if (total > highest) {
                highest = total;
                topper = student.name;
            }

            totalPercentage += percentage;

            output += `
            <tr class="${result === 'Fail' ? 'fail' : ''}">
                <td>${student.name}</td>
                <td>${total}</td>
                <td>${percentage.toFixed(2)}%</td>
                <td>${grade}</td>
                <td>${result}</td>
            </tr>`;
        });

        output += `</table>`;

        let average = totalPercentage / students.length;

        output += `
        <div class="summary">
            Topper: ${topper}<br>
            Class Average: ${average.toFixed(2)}%<br>
            Passed: ${passed} out of ${students.length} students
        </div>`;

        document.getElementById("output").innerHTML = output;
    }
</script>

</body>
</html>